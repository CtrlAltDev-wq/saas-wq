<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Development and tests: human readable console output enriched with tenant and trace context. -->
    <springProfile name="dev | test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] [trace=%X{traceId:-} tenant=%X{tenantId:-} user=%X{userId:-}] %cyan(%logger{36}) - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Any other profile: one JSON document per line, ready for Loki, ELK or CloudWatch. -->
    <springProfile name="!dev">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"application":"saas-wq-server","service":"saas-wq"}</customFields>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

</configuration>
