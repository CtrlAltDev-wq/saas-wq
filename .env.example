# Copy this file to .env before running docker compose.
# Infrastructure
MYSQL_ROOT_PASSWORD=root123
DB_NAME=saas_wq
DB_USER=saas
DB_PASSWORD=saas123
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

# Published host ports
BACKEND_HOST_PORT=8081
WEB_HOST_PORT=8080

# Security
JWT_SECRET=saas-wq-local-development-secret-key-change-me
JWT_EXPIRATION=PT12H

# Tenant based rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Stripe (optional: checkout is disabled while the secret key is empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8080/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8080/billing/cancel
STRIPE_CURRENCY=usd

# Observability (optional: leave ZIPKIN_ENDPOINT empty to disable span export)
TRACING_SAMPLING_PROBABILITY=1.0
ZIPKIN_ENDPOINT=
